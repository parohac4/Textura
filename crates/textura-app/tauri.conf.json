{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Textura",
  "identifier": "cz.parohac4.textura",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Textura",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "shortDescription": "Poznámky v obyčejných .txt souborech",
    "longDescription": "Textura je poznámkovač nad obyčejnými UTF-8 .txt soubory. Poznámka zůstává čitelná jako prostý text i bez aplikace — bez Markdownu, bez povinného markupu a bez skrytého stavu v databázi."
  }
}
